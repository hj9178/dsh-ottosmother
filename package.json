{
  "name": "dsh-ottosmother",
  "version": "0.4.0",
  "description": "滚木插件：把「滚木 = 没有」「棍母 = 不存在」的用语规则写进 system prompt，由模型自己理解用户输入、自己组织自然的回复，不改写任何消息。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "cordis",
    "ottosmother",
    "self-lexicon",
    "system-prompt"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
