  "description": "A private glossary for the model: it reads 「滚木」 as 没有 and 「棍母」 as 不存在, and phrases its own replies naturally with those words. Injects one system-prompt section; rewrites nothing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hj9178/dsh-ottosmother.git"
  },
  "homepage": "https://github.com/hj9178/dsh-ottosmother#readme",
  "bugs": {
    "url": "https://github.com/hj9178/dsh-ottosmother/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "cordis",
    "ottosmother",
    "self-lexicon",
    "system-prompt"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.3"
  },
