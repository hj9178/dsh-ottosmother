{
  "name": "dsh-ottosmother",
  "version": "0.6.1",
  "description": "A private glossary for the model, stored as YAML: it reads the words in the glossary as their meanings and phrases its own replies naturally with them. Ships classified glossaries and a settings page; registers one system-prompt section; rewrites nothing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hj9178/dsh-ottosmother.git"
  },
  "homepage": "https://github.com/hj9178/dsh-ottosmother#readme",
  "bugs": {
    "url": "https://github.com/hj9178/dsh-ottosmother/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "cordis",
    "ottosmother",
    "self-lexicon",
    "system-prompt",
    "settings"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./client.js"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "glossaries",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
